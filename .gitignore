# ─────────────────────────────────────────────────────────────
# Root .gitignore — Blume monorepo
# (apps/mobile/.gitignore tetap ada untuk aturan khusus React Native)
# ─────────────────────────────────────────────────────────────

# ── Node / React Native ──
node_modules/
npm-debug.log
yarn-error.log
.metro-health-check*
coverage/
*.jsbundle

# ── Android ──
build/
.gradle/
local.properties
.idea/
*.iml
*.hprof
.cxx/
*.keystore
!debug.keystore
.kotlin/

# ── iOS ──
Pods/
DerivedData/
*.xcuserstate
**/.xcode.env.local

# ── Python ──
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Environment (jangan commit rahasia) ──
.env
!.env.example

# ── Backend runtime ──
services/api/blume.db
services/api/uploads/
services/api/*.db
services/api/*.sqlite3

# ── Model & artefak besar ──
ml/models/*.pt
ml/models/*.onnx
ml/models/*.pth
*.onnx
*.tflite

# ── OS ──
.DS_Store
Thumbs.db
desktop.ini

# ── Tooling ──
graphify-out/

# folder kerja sementara (script adb, screenshot)
.tmp/
