# ─────────────────────────────────────────────────────────────
# Contoh environment untuk services/api
# Copy ke .env lalu sesuaikan:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── Server ──
PORT=3000
HOST=0.0.0.0

# URL publik untuk menyusun imageUrl hasil scan.
# Kosongkan saat lokal (otomatis pakai base_url request, mis. http://10.0.2.2:3000).
PUBLIC_BASE_URL=

# ── Database ──
# Lokal: SQLite. Produksi: PostgreSQL (uncomment baris kedua)
DATABASE_URL=sqlite:///./blume.db
# DATABASE_URL=postgresql+psycopg://blume:password@localhost:5432/blume

# ── Auth ──
# WAJIB diganti di produksi: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=ganti-dengan-string-acak-panjang
JWT_EXPIRE_DAYS=30

# ── Upload ──
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# ── Model ML ──
# Path relatif terhadap services/api/ (monorepo)
MODEL_PATH=../../ml/models/best_skindex_v5_320.pt
ARTIFACTS_DIR=./app/ml/artifacts

# Load model saat startup (1 = lambat start tapi request pertama cepat)
WARM_MODEL=1
